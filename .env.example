# Copy to .env and fill in real secrets. Never commit .env.
# Shed pilot: Postgres + compose defaults (db service in docker/docker-compose.yml)
POSTGRES_PASSWORD=CHANGE-ME-db-password
DATABASE_URL=postgresql+psycopg://cmr:${POSTGRES_PASSWORD}@db:5432/cmr
# Local dev without docker: DATABASE_URL=sqlite:///./data/cmr_cases.db
BACKUP_KEEP_DAYS=14

# Auth (generate fresh values for every environment)
HARNESS_API_KEY=CHANGE-ME-long-random-string
TOOL_MODULE_TOKEN=CHANGE-ME-other-long-random-string
# Pilot lock: STRICT_AUTH=1 refuses defaults + requires login everywhere.
# Set to 1 on the office PC. Keep 0 for local laptop dev.
STRICT_AUTH=1

# Web
HARNESS_HOST=0.0.0.0
HARNESS_PORT=8080

# Inference: mock | openrouter | gemini | http (OpenAI-compatible) | local_qwen
INFERENCE_PROVIDER=mock
# OpenRouter: key at https://openrouter.ai/keys (add a few $ credits; free models exist)
# INFERENCE_PROVIDER=openrouter
# INFERENCE_API_KEY=<OPENROUTER_KEY>
# OPENROUTER_MODEL=google/gemini-2.5-flash
# Gemini direct: key at https://aistudio.google.com/apikey
# INFERENCE_PROVIDER=gemini
# INFERENCE_API_KEY=<GEMINI_API_KEY>
# GEMINI_MODEL=gemini-3.8-flash
# Generic OpenAI-compatible endpoint:
# INFERENCE_PROVIDER=http
# INFERENCE_HTTP_URL=http://localhost:8000/v1/chat/completions
# INFERENCE_API_KEY=

# Worker
WORKER_POLL_INTERVAL_S=2.0
WORKER_CONCURRENCY=2
# Web base URL the worker heartbeats to (compose sets http://web:8080;
# native dev: http://127.0.0.1:8080. Empty = no heartbeat posts.)
# WEB_URL=http://127.0.0.1:8080

# Mock CMR registry (relational) + operator service (own process, :8081)
# Compose default: own Postgres database (created by docker/init-db.sh).
# Local native dev without docker: REGISTRY_DATABASE_URL=sqlite:///./var/registry.db
REGISTRY_DATABASE_URL=postgresql+psycopg://cmr:${POSTGRES_PASSWORD}@db:5432/cmr_registry
REGISTRY_HOST=0.0.0.0
REGISTRY_PORT=8081
# Operator allowlist: usernames permitted on the registry service.
# Sign-in is shared (same users table); this list is the second gate.
REGISTRY_OPERATORS=Baba

# Office-PC remote access ($0 option — pick ONE, leave the other empty)
# A) Cloudflare Tunnel (no open ports, needs a Cloudflare account):
#    cloudflared tunnel login && cloudflared tunnel create cmr-office
#    cloudflared tunnel route dns cmr-office cmr.youroffice.com
#    then paste the token below and start with: docker compose --profile tunnel up -d
# TUNNEL_TOKEN=PASTE-ME-cloudflared-tunnel-token
# B) Tailscale (no domain needed): install + `tailscale up` on office PC and
#    remote device, then `tailscale serve 8080`. No .env change needed.
# Bind addresses (defaults are localhost-only; only override for LAN serving)
# WEB_BIND=127.0.0.1
# REGISTRY_BIND=127.0.0.1
# Host port remap (host has 8080/8081 busy, or parallel test stacks)
# WEB_PORT=8080
# REGISTRY_PORT=8081

# First admin (used by deploy/install.sh; ignored by the app itself).
# On a fresh database the installer creates this login as admin.
# ADMIN_USER=Baba
# ADMIN_PASSWORD=CHANGE-ME-min-8-chars
